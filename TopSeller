-- Improved webhook system
local function SendWebhook(ItemName, Price, Amount)
    if getgenv().ToppSeller.Webhook == "" then return end
    
    local data = {
        ["content"] = "🎉 New Sale!",
        ["embeds"] = {{
            ["title"] = "**"..ItemName.."** sold!",
            ["description"] = string.format("💰 **Price:** %s \n🔢 **Amount:** %s", Price, Amount),
            ["color"] = 65280,
            ["footer"] = {["text"] = "ToppSeller | "..os.date("%X")}
        }}
    }
    
    local success, err = pcall(function()
        return request({
            Url = getgenv().ToppSeller.Webhook,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = game:GetService("HttpService"):JSONEncode(data)
        })
    end)
    
    if not success then
        warn("Webhook failed:", err)
    end
end

-- Inventory tracking for sales detection
local lastInventory = {}
local function TrackSales()
    while task.wait(5) do
        local currentInventory = Savemod.Get().Inventory or {}
        
        for class, items in pairs(lastInventory) do
            if getgenv().ToppSeller.Items[class] then
                for uuid, item in pairs(items) do
                    if not currentInventory[class] or not currentInventory[class][uuid] or currentInventory[class][uuid]._am < item._am then
                        local configItem = getgenv().ToppSeller.Items[class][item.id]
                        if configItem and configItem.pt == item.pt and configItem.sh == item.sh and configItem.tn == item.tn then
                            local price = ConvertPrice(configItem.Price, GetRap(class, item))
                            local amountSold = item._am - (currentInventory[class] and currentInventory[class][uuid] and currentInventory[class][uuid]._am or 0)
                            if amountSold > 0 then
                                UpdateSold(amountSold)
                                SendWebhook(item.id, math.ceil(price), amountSold)
                            end
                        end
                    end
                end
            end
        end
        
        lastInventory = {}
        for class, items in pairs(currentInventory) do
            lastInventory[class] = {}
            for uuid, item in pairs(items) do
                lastInventory[class][uuid] = table.clone(item)
            end
        end
    end
end

