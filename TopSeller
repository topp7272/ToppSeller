-- Core Variables
local totalDiamonds = 0
local lastDiamonds = 0

-- Helper function to format numbers with commas
local function formatNumber(n)
    return tostring(n):reverse():gsub("%d%d%d", "%1,"):reverse():gsub("^,", "")
end

-- Webhook Function (Diamond Tracking)
local function SendWebhook(amountGained)
    if not getgenv().ToppSeller.Webhook then return end
    
    local data = {
        ["content"] = "@everyone",
        ["embeds"] = {{
            ["title"] = "💎 DIAMONDS GAINED! 💎",
            ["description"] = string.format("+ **%s** Diamonds\n\nTotal: **%s** Diamonds", 
                formatNumber(amountGained), 
                formatNumber(totalDiamonds)),
            ["color"] = 5814783, -- Light blue color for diamonds
            ["footer"] = {["text"] = "ToppSeller | "..os.date("%X")}
        }}
    }
    
    local success, response = pcall(function()
        request({
            Url = getgenv().ToppSeller.Webhook,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(data)
        })
    end)
    
    if not success then
        warn("Webhook failed:", response)
    end
end

-- Diamond Tracker
local function TrackDiamonds()
    while task.wait(1) do
        local currentDiamonds = 0
        local inventory = game:GetService("ReplicatedStorage").Library.Client.Save.Get().Inventory or {}
        
        -- Find diamonds in currency
        for _, currency in pairs(inventory.Currency or {}) do
            if currency.id == "Diamonds" then
                currentDiamonds = currency._am or 0
                break
            end
        end

        -- Update UI
        totalDiamonds = currentDiamonds
        SoldLabel.Text = "Diamonds: " .. formatNumber(currentDiamonds)

        -- Check for increase
        if currentDiamonds > lastDiamonds and lastDiamonds > 0 then
            local gained = currentDiamonds - lastDiamonds
            SendWebhook(gained)
        end

        lastDiamonds = currentDiamonds
    end
end

-- Game Setup
repeat task.wait() until game:IsLoaded()
local LocalPlayer = Players.LocalPlayer
repeat task.wait() until LocalPlayer and not LocalPlayer.PlayerGui:FindFirstChild("__INTRO")

local Library = ReplicatedStorage:WaitForChild("Library")
local Client = Library:WaitForChild("Client")

local function requireModule(name)
    return require(Client:WaitForChild(name))
end

local RAPCmds = requireModule("RAPCmds")
local Network = requireModule("Network")
local SaveMod = requireModule("Save")

local function GetRap(Class, ItemTable)
    local itemModule = Library.Items:FindFirstChild(Class.."Item")
    if not itemModule then return 0 end
    
    local Item = require(itemModule)(ItemTable.id)
    if ItemTable.sh then Item:SetShiny(true) end
    if ItemTable.pt == 1 then Item:SetGolden() end
    if ItemTable.pt == 2 then Item:SetRainbow() end
    if ItemTable.tn then Item:SetTier(ItemTable.tn) end

    return RAPCmds.Get(Item) or 0
end

local function ConvertPrice(Price, Rap)
    if type(Price) == "string" then
        local Percentage = tonumber(Price:match("^(%d+)%%"))
        if Percentage then return (Percentage/100)*Rap end
    end
    return Price
end

local function ClaimBooth()
    local BoothSpawns = game.workspace.TradingPlaza.BoothSpawns:FindFirstChildWhichIsA("Model")
    if not BoothSpawns then return false end

    for _, Booth in ipairs(workspace.__THINGS.Booths:GetChildren()) do
        if Booth.Info.BoothBottom.Frame.Top.Text == LocalPlayer.DisplayName.."'s Booth!" then
            LocalPlayer.Character.HumanoidRootPart.CFrame = Booth.Table.CFrame * CFrame.new(5,0,0)
            return true
        end
    end

    LocalPlayer.Character.HumanoidRootPart.CFrame = BoothSpawns.Table.CFrame * CFrame.new(5,0,0)
    Network.Invoke("Booths_ClaimBooth", tostring(BoothSpawns:GetAttribute("ID")))
    task.wait(2)
    return true
end

local function SetupAntiAFK()
    local VirtualUser = game:GetService("VirtualUser")
    for _, v in pairs(getconnections(LocalPlayer.Idled)) do v:Disable() end
    LocalPlayer.Idled:Connect(function()
        VirtualUser:ClickButton2(Vector2.new(math.random(0,1000), math.random(0,1000)))
    end)
end

local function StartSelling()
    while task.wait(5) do
        local inventory = SaveMod.Get().Inventory
        if not inventory then continue end

        for uid, item in pairs(inventory.Pet or {}) do
            local config = getgenv().ToppSeller.Items.Pet[item.id]
            if config then
                local price = ConvertPrice(config.Price, GetRap("Pet", item))
                local maxAmount = math.min(item._am or 1, 15000, math.floor(25e9/price))
                
                pcall(function()
                    Network.Invoke("Booths_CreateListing", uid, math.ceil(price), maxAmount)
                end)
                task.wait(1)
            end
        end
    end
end

-- Main Execution
if ClaimBooth() then
    SetupAntiAFK()
    coroutine.wrap(TrackDiamonds)()
    StartSelling()
else
    warn("[ToppSeller] Failed to claim booth!")
end
