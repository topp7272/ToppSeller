if not getgenv().ToppSeller then
    warn("[ToppSeller] Config not found!")
    return
end

repeat task.wait() until game:IsLoaded()
local LocalPlayer = game:GetService("Players").LocalPlayer
repeat task.wait() until LocalPlayer and not LocalPlayer.PlayerGui:FindFirstChild("__INTRO")

local Library = game.ReplicatedStorage:FindFirstChild("Library")
if not Library then
    warn("[ToppSeller] Library not found!")
    return
end

local Client = Library:FindFirstChild("Client")
if not Client then
    warn("[ToppSeller] Client folder not found!")
    return
end

local function requireModule(name)
    local module = Client:FindFirstChild(name)
    if not module then
        warn("[ToppSeller] Missing module:", name)
        return nil
    end
    return require(module)
end

local RAPCmds = requireModule("RAPCmds")
local Network = requireModule("Network")
local Savemod = requireModule("Save")

if not (RAPCmds and Network and Savemod) then
    return
end

if game.PlaceId == 8737899170 or game.PlaceId == 16498369169 then
    while true do 
        Network.Invoke("Travel to Trading Plaza") 
        task.wait(1) 
    end
end

local function SendWebhook(ItemName, Price, Amount)
    if getgenv().ToppSeller.Webhook == "" then return end
    
    local data = {
        ["content"] = "🎉 New Sale!",
        ["embeds"] = {{
            ["title"] = "**" .. ItemName .. "** sold!",
            ["description"] = string.format("💰 **Price:** %s \n🔢 **Amount:** %s", Price, Amount),
            ["color"] = 65280,
            ["footer"] = {["text"] = "ToppSeller | " .. os.date("%X")}
        }}
    }
    
    request({
        Url = getgenv().ToppSeller.Webhook,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = game:GetService("HttpService"):JSONEncode(data)
    })
end

local GetRap = function(Class, ItemTable)
    local itemModule = Library.Items:FindFirstChild(Class .. "Item")
    if not itemModule then return 0 end
    
    local Item = require(itemModule)(ItemTable.id)
    if ItemTable.sh then Item:SetShiny(true) end
    if ItemTable.pt == 1 then Item:SetGolden() end
    if ItemTable.pt == 2 then Item:SetRainbow() end
    if ItemTable.tn then Item:SetTier(ItemTable.tn) end

    return RAPCmds.Get(Item) or 0
end

local ConvertPrice = function(Price, Rap)
    if type(Price) == "string" then
        local Percentage = tonumber(Price:match("^(%d+)%%"))
        if Percentage then
            return (Percentage / 100) * Rap
        end
    end
    return Price
end

local function ClaimBooth()
    local HaveBooth = false
    local BoothSpawns = game.workspace.TradingPlaza.BoothSpawns:FindFirstChildWhichIsA("Model")
    
    if not BoothSpawns then
        warn("[ToppSeller] No booth spawns found!")
        return false
    end

    for _, Booth in ipairs(workspace.__THINGS.Booths:GetChildren()) do
        if Booth:IsA("Model") and Booth.Info.BoothBottom.Frame.Top.Text == LocalPlayer.DisplayName .. "'s Booth!" then
            HaveBooth = true
            LocalPlayer.Character.HumanoidRootPart.CFrame = Booth.Table.CFrame * CFrame.new(5, 0, 0)
            break
        end
    end

    if not HaveBooth then
        LocalPlayer.Character.HumanoidRootPart.CFrame = BoothSpawns.Table.CFrame * CFrame.new(5, 0, 0)
        Network.Invoke("Booths_ClaimBooth", tostring(BoothSpawns:GetAttribute("ID")))
        task.wait(2)
    end
    
    return true
end

local function SetupAntiAFK()
    local VirtualUser = game:GetService("VirtualUser")
    for _, v in pairs(getconnections(LocalPlayer.Idled)) do 
        v:Disable() 
    end
    LocalPlayer.Idled:Connect(function() 
        VirtualUser:ClickButton2(Vector2.new(math.random(0, 1000), math.random(0, 1000)) 
    end)

    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if not checkcaller() then
            local Name = tostring(self)
            if table.find({"Server Closing", "Idle Tracking: Update Timer", "Move Server"}, Name) then
                return nil
            end
        end
        return old(self, ...)
    end)
    Network.Fire("Idle Tracking: Stop Timer")
end

local function StartSelling()
    while task.wait(5) do 
        local BoothQueue = {}
        local inventory = Savemod.Get().Inventory
        
        if not inventory then
            warn("[ToppSeller] Failed to get inventory!")
            task.wait(10)
            continue
        end

        for Class, Items in pairs(inventory) do
            if getgenv().ToppSeller.Items[Class] then
                for _, v in pairs(Items) do
                    local configItem = getgenv().ToppSeller.Items[Class][v.id]
                    if configItem and configItem.pt == v.pt and configItem.sh == v.sh and configItem.tn == v.tn then
                        table.insert(BoothQueue, {
                            Name = v.id,
                            Price = configItem.Price, 
                            UUID = _, 
                            Item = v, 
                            Rap = GetRap(Class, v)
                        })
                    end
                end
            end
        end

        table.sort(BoothQueue, function(a, b) return a.Rap > b.Rap end)
        
        for _, v in ipairs(BoothQueue) do
            local price = ConvertPrice(v.Price, v.Rap)
            local MaxAmount = math.min(v.Item._am or 1, 15000, math.floor(25e9 / price))
            
            local success = pcall(function()
                Network.Invoke("Booths_CreateListing", v.UUID, math.ceil(price), MaxAmount)
            end)
            
            if success then
                SendWebhook(v.Name, math.ceil(price), MaxAmount)
            end
            
            task.wait(1)
        end
    end
end

if ClaimBooth() then
    SetupAntiAFK()
    StartSelling()
else
    warn("[ToppSeller] Failed to claim booth!")
end
